# ==========================================
# 拼多多自动回复系统 - Git 忽略规则
# ------------------------------------------
# 说明：本项目为多服务架构（backend / websocket / scheduler / common + 前端 frontend），
#       下列规则覆盖 Python、Node、Docker、测试缓存、运行时数据与编辑器/系统产物。
# ==========================================

# ===== 环境变量（含密钥/密码，禁止提交；仅保留模板 .env.example）=====
.env
.env.*
!.env.example
# 前端本地环境覆盖文件
.env.local
.env.*.local

# ===== 凭据、Cookie 与私钥（禁止提交）=====
credential*.json
credentials*.json
cookie*.json
cookies*.json
storage_state*.json
auth_state*.json
auth.json
session*.json
state*.json
*.har
*.jks
*.keystore
*.crt
*.pem
*.key
*.pfx
*.p12
.npmrc
.pypirc
.netrc
docker-compose.override.yml

# ===== Python 字节码与缓存 =====
__pycache__/
*.py[cod]
*$py.class
*.so

# ===== Python 虚拟环境 =====
.venv/
venv/
env/
ENV/
.python-version

# ===== Python 打包与构建产物 =====
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
sdist/
wheels/
*.egg-info/
*.egg
.installed.cfg
MANIFEST

